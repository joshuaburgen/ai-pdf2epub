include README.md LICENSE NOTICE.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include requirements.txt requirements-review.txt .env.example
recursive-include bookocr *.py
recursive-include config *.example.json
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
global-exclude *.py[cod]
prune input
prune output
prune data
prune runs
prune tools
prune .venv
