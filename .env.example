# OpenAI-compatible Chat Completions endpoint; the model must accept images.
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_API_KEY=

# Choose a genuinely independent, capable vision model for stage 3.
# Stage 5 can use a text-only model via --judge-prefix TEXT_JUDGE instead.
JUDGE_BASE_URL=https://api.example.com/v1
JUDGE_MODEL=your-independent-vision-model
JUDGE_API_KEY=

# Optional separate text judge:
# TEXT_JUDGE_BASE_URL=https://api.example.com/v1
# TEXT_JUDGE_MODEL=your-independent-text-model
# TEXT_JUDGE_API_KEY=
